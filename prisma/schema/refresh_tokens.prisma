model RefreshToken {
  id            String  @id @default(cuid())
  user_id       String
  user          User    @relation(fields: [user_id], references: [id])
  refresh_token String  @unique
  expires_at    DateTime
  created_at    DateTime @default(now())

  @@map("refresh_tokens")
  @@index([user_id])
  @@index([refresh_token])
}
