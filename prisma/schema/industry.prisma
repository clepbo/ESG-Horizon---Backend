model Industry {
  id           Int                @id @default(autoincrement())
  name         String             @unique @map("industry")
  sectorId     Int
  sector       Sector             @relation(fields: [sectorId], references: [id])
  subsidiaries Subsidiary[]
  companies    Company[]
  pillars      PillarOnIndustry[]

  @@unique([sectorId, name])
  @@map("industries")
}
