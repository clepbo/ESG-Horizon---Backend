enum RoleTypes {
  SUPER_ADMIN
  RESTRICTED_ADMIN
  ADMIN_VIEWER
  ADMIN_EDITOR
  SUSTAINABILITY_MANAGER
  C_SUITE_EXEC
  REGULATOR
  INVESTOR
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  users       User[]

  @@map("roles")
}

