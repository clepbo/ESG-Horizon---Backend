model DisclosureTopicLegacy {
  id           Int                @id @default(autoincrement())
  assessmentId Int
  category     DisclosureCategory
  topic        String
  subtopic     String
  assessment   Assessment         @relation("AssessmentToDisclosureTopic", fields: [assessmentId], references: [id], onDelete: Cascade)
  ghgData      GhgData?

  @@unique([assessmentId, category, topic, subtopic])
  @@index([assessmentId])
  @@map("disclosure_topics_legacy")
}

model GhgData {
  id                Int                  @id @default(autoincrement())
  disclosureTopicId Int                  @unique
  disclosureTopic   DisclosureTopicLegacy @relation(fields: [disclosureTopicId], references: [id], onDelete: Cascade)
  scope1            Scope1Data?

  @@index([disclosureTopicId])
  @@map("ghg_data")
}

enum DisclosureCategory {
  industry_specific
  supplementary
}
