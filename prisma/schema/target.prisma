model Target {
  id            Int            @id @default(autoincrement())
  name          String
  companyId     Int
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type          TargetType     @default(GENERAL)
  description   String?
  baselineYear  Int // Year as integer
  targetYear    Int // Year as integer
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  generalTarget GeneralTarget?
  scopeTargets  ScopeTarget[]
  createdById   Int

  @@unique([companyId, name])
  @@index([companyId])
  @@index([type])
}

model GeneralTarget {
  id                   Int      @id @default(autoincrement())
  targetId             Int      @unique
  target               Target   @relation(fields: [targetId], references: [id], onDelete: Cascade)
  reductionPercentage  Float
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  baselineYearEmission Float    @default(00)
  targetEmission       Float    @default(00)
  currentEmission      Float?
}

model ScopeTarget {
  id                   Int           @id @default(autoincrement())
  targetId             Int
  target               Target        @relation(fields: [targetId], references: [id], onDelete: Cascade)
  scope                EmissionScope
  reductionPercentage  Float
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  baselineYearEmission Float         @default(00)
  targetEmission       Float         @default(00)
  currentEmission      Float?

  @@unique([targetId, scope])
  @@index([targetId])
}

enum TargetType {
  GENERAL
  SCOPE
  BOTH
}

enum EmissionScope {
  SCOPE1
  SCOPE2
  SCOPE3
}
