model User {
  id                String        @id @default(cuid())
  email             String        @unique
  password          String
  first_name        String
  last_name         String?
  phone_number      String?
  role              Role          @default(SUSTAINABILITY_MANAGER)
  company           String?
  company_id        String?
  permissions       String[]
  status            UserStatus    @default(PENDING)
  profile_photo_url String?
  last_login        DateTime?
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt
  refreshTokens     RefreshToken[]

  @@map("users")
}

enum Role {
  SUPER_ADMIN
  SUSTAINABILITY_MANAGER
  C_SUITE_EXEC
  DEPT_HEAD
  REGULATOR
  INVESTOR
}

enum UserStatus {
  PENDING
  APPROVED
  SUSPENDED
  DISABLED
}
