model CompanySubscription {
  id              Int                @id @default(autoincrement())
  company_id      Int
  subscription_id Int
  start_date      DateTime
  end_date        DateTime?
  status          SubscriptionStatus @default(ACTIVE)
  created_by      Int
  updated_by      Int
  created_at      DateTime           @default(now())
  updated_at      DateTime           @updatedAt
  Company         Company            @relation("CompanySubs", fields: [company_id], references: [id])
  Subscription    Subscription       @relation("CompanySubs", fields: [subscription_id], references: [id])

  @@index([company_id])
  @@index([subscription_id])
  @@index([status])
  @@map("company_subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  TRIAL
}
