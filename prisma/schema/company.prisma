enum CompanyStatus {
  pending
  active
  suspended
  disabled
}

enum CompanyType {
  esg
  investor
  regulator
}

model Company {
  id                  Int    @id @default(autoincrement())
  name                String @unique
  registration_number String

  industryId Int?
  industry   Industry? @relation(fields: [industryId], references: [id])

  isinCode       String?
  isoCountryCode String

  address                    String
  country                    String?
  currency                   String?
  contact_email              String
  website                    String?
  contact_phone              String
  company_logo_url           String?
  company_logo_url_public_id String?
  company_type               CompanyType?

  status                    CompanyStatus @default(pending)
  created_at                DateTime      @default(now())
  created_by                Int
  updated_at                DateTime      @updatedAt
  updated_by                Int
  current_subscription_tier Int?

  subscription         Subscription?         @relation(fields: [current_subscription_tier], references: [id], name: "CompanyCurrentSubscription")
  users                User[]                @relation("CompanyUsers")
  companySubscriptions CompanySubscription[] @relation("CompanySubs")
  departments          Department[]
  invitations          Invitation[]

  subsidiaries Subsidiary[] @relation("Subsidiaries")

  @@index([status])
  @@index([created_at])
  @@map("companies")
}
