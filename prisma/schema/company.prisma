model Company {
  id                         Int                   @id @default(autoincrement())
  name                       String                @unique
  registration_number        String?
  industryId                 Int?
  isinCode                   String?
  isoCountryCode             String?
  address                    String?
  country                    String?
  currency                   String?
  contact_email              String?
  website                    String?
  contact_phone              String?
  company_logo_url           String?
  status                     CompanyStatus         @default(pending)
  created_at                 DateTime              @default(now())
  created_by                 Int?
  updated_at                 DateTime              @updatedAt
  updated_by                 Int?
  current_subscription_tier  Int?
  company_logo_url_public_id String?
  company_type               CompanyType?
  staff_strength             String?
  requireAssessmentReview    Boolean               @default(false)
  activities                 Activities[]
  departments                Department[]
  invitations                Invitation[]
  subsidiaries               Subsidiary[]          @relation("Subsidiaries")
  assessments                Assessment[]
  creator                    User?                 @relation("CreatedCompanies", fields: [created_by], references: [id])
  subscription               Subscription?         @relation("CompanyCurrentSubscription", fields: [current_subscription_tier], references: [id])
  industry                   Industry?             @relation(fields: [industryId], references: [id])
  updater                    User?                 @relation("UpdatedCompanies", fields: [updated_by], references: [id])
  companySubscriptions       CompanySubscription[] @relation("CompanySubs")
  users                      User[]                @relation("CompanyUsers")

  @@index([status])
  @@index([created_at])
  @@map("companies")
}

enum CompanyStatus {
  pending
  active
  suspended
  disabled
}

enum CompanyType {
  esg
  investor
  regulator
}
