model Report {
  id                                  Int        @id @default(autoincrement())
  assessmentId                        Int        @unique
  ghg_total_emissions                 Float
  startMonth                          String?
  startYear                           String?
  endMonth                            String?
  endYear                             String?
  subsidiary                          String?
  progress                            Int?
  ghg_scope_one                       Float
  ghg_scope_two                       Float
  ghg_scope_three                     Float
  ghg_datacount_scope_one             Float
  ghg_datacount_scope_two             Float
  ghg_datacount_scope_three           Float
  environmental_total_emissions       Float
  environmental_scope_one             Float
  environmental_scope_two             Float
  environmental_scope_three           Float
  environmental_datacount_scope_one   Float
  environmental_datacount_scope_two   Float
  environmental_datacount_scope_three Float
  social_total_emissions              Float
  social_scope_one                    Float
  social_scope_two                    Float
  social_scope_three                  Float
  social_datacount_scope_one          Float
  social_datacount_scope_two          Float
  social_datacount_scope_three        Float
  governance_total_emissions          Float
  governance_scope_one                Float
  governance_scope_two                Float
  governance_scope_three              Float
  governance_datacount_scope_one      Float
  governance_datacount_scope_two      Float
  governance_datacount_scope_three    Float
  human_total_emissions               Float?     @default(0)
  human_scope_one                    Float?     @default(0)
  human_scope_two                    Float?     @default(0)
  human_scope_three                  Float?     @default(0)
  human_datacount_scope_one          Float?     @default(0)
  human_datacount_scope_two          Float?     @default(0)
  human_datacount_scope_three        Float?     @default(0)
  business_total_emissions            Float?     @default(0)
  business_scope_one                 Float?     @default(0)
  business_scope_two                 Float?     @default(0)
  business_scope_three               Float?     @default(0)
  business_datacount_scope_one       Float?     @default(0)
  business_datacount_scope_two       Float?     @default(0)
  business_datacount_scope_three     Float?     @default(0)
  leadership_total_emissions          Float?     @default(0)
  leadership_scope_one               Float?     @default(0)
  leadership_scope_two               Float?     @default(0)
  leadership_scope_three             Float?     @default(0)
  leadership_datacount_scope_one     Float?     @default(0)
  leadership_datacount_scope_two     Float?     @default(0)
  leadership_datacount_scope_three   Float?     @default(0)
  completed_sections                  Int?       @default(0)
  total_sections                      Int?       @default(100)
  assessment                          Assessment @relation(fields: [assessmentId], references: [id])

  @@map("report")
}
