enum AssessmentStatus {
  draft
  submitted
  reviewed
}

model Assessment {
  id Int @id @default(autoincrement())

  companyId Int
  company   Company @relation(fields: [companyId], references: [id])

  created_by Int?
  updated_by Int?

  creator User? @relation("CreatedAssessment", fields: [created_by], references: [id])
  updater User? @relation("UpdatedAssessment", fields: [updated_by], references: [id])

  subsidiary String
  startMonth String
  startYear  String
  endMonth   String
  endYear    String

  assessmentData Json

  status AssessmentStatus @default(draft)

  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  DisclosureTopic DisclosureTopic[]

  @@unique([companyId, status], name: "unique_draft_per_company")
  @@index([companyId])
  @@index([created_by])
  @@index([updated_by])
  @@map("assessments")
}
