model Assessment {
  id               Int               @id @default(autoincrement())
  subsidiary       String
  status           AssessmentStatus  @default(in_progress)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  assessmentData   Json
  companyId        Int
  created_by       Int?
  endMonth         String
  endYear          String
  startMonth       String
  startYear        String
  updated_by       Int?
  rejection_reason String?
  reviewedAt       DateTime?
  reviewed_by      Int?
  submittedAt      DateTime?
  approvedAt       DateTime?
  company          Company           @relation(fields: [companyId], references: [id])
  creator          User?             @relation("CreatedAssessment", fields: [created_by], references: [id])
  reviewer         User?             @relation("ReviewedAssessment", fields: [reviewed_by], references: [id])
  updater          User?             @relation("UpdatedAssessment", fields: [updated_by], references: [id])
  DisclosureTopic  DisclosureTopic[]
  report           Report?
  taskAssignments  TaskAssignment[]

  @@index([companyId])
  @@index([created_by])
  @@index([updated_by])
  @@index([companyId, status, createdAt])
  @@map("assessments")
}

enum AssessmentStatus {
  in_progress
  awaiting_review
  submitted_approved
  approved
  unapproved_rejected
  declined
}
