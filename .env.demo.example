# ---------------------------------------------------------------------------
# Demo environment
#
# Copy to .env in the environment you want to use for client demos:
#     cp .env.demo.example .env
#
# This file contains NO real credentials and must never be given any. The demo
# instance is deliberately isolated from production - different database,
# different secrets, its own throwaway third-party keys (or none at all).
# ---------------------------------------------------------------------------

# Required. The demo seed and reset refuse to run unless this is exactly "true".
DEMO_MODE=true

# Point at a database used ONLY for demos. The guard rejects URLs containing
# prod/production/live or a known managed-host domain; override with
# DEMO_ALLOW_RISKY_URL=true only if you are certain the target is disposable.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/horizon_demo?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/horizon_demo?schema=public"

# Generate a throwaway value, e.g. `openssl rand -base64 32`.
# Never reuse the production signing key here.
JWT_SECRET="replace-me-with-a-throwaway-demo-secret"
JWT_EXPIRESIN="1d"

ALLOWED_ORIGINS="http://localhost:3001,http://localhost:3000"
FRONTEND_URL="http://localhost:3001"

# Third-party integrations. Leave blank to keep the demo fully offline -
# nothing in the demo dataset depends on them. If you do fill them in, use
# sandbox/test keys, never production ones.
BREVO_API_KEY=""
SENDER_EMAIL="demo@example.invalid"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
UPLOAD_DEFAULT_FOLDER="demo-uploads"
UPLOAD_MAX_FILE_SIZE="5242880"

# Optional. Changes the deterministic seed, giving different numbers while
# keeping the same structure. Leave unset for reproducible demos.
# DEMO_SEED=20260921
